{
  "id": "waTextPilot26Nov6",
  "name": "WhatsApp text → Voice Inbox (pilot)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "waha-voice-inbox-pilot",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "d3e2026a-a17d-4f1c-9e00-000000000001",
      "name": "Receive WAHA message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "2a0f048a-293b-46ab-b9f8-a045972d96d8",
      "credentials": {
        "httpHeaderAuth": {
          "id": "WaPilotInbound26",
          "name": "WAHA pilot webhook"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const event = $input.first().json.body;\nconst message = event?.payload;\nconst senders = ['6287729072000@c.us', '108121657733360@lid'];\nif (event?.event !== 'message' || event.session !== 'default' || !message) return [];\nif (!senders.includes(message.from) || message.fromMe !== false || message.hasMedia !== false) return [];\nif (typeof message.body !== 'string' || !/^task:/i.test(message.body)) return [];\nconst title = message.body.slice(5).trim().replace(/\\s+/g, ' ');\nconst messageKey = typeof message.id === 'string' && /^false_.+_([a-zA-Z0-9-]{8,128})$/.exec(message.id);\nif (!title || title.length > 200 || !messageKey) return [];\nreturn [{ json: { chatId: message.from, title, reference: 'WAHA pilot message ' + messageKey[1] } }];"
      },
      "id": "d3e2026a-a17d-4f1c-9e00-000000000002",
      "name": "Validate test message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getAll",
        "team": "1100310000034143",
        "space": "1100310000147758",
        "folderless": true,
        "list": "1100310000198006",
        "returnAll": true,
        "filters": {
          "includeClosed": true
        }
      },
      "id": "d3e2026a-a17d-4f1c-9e00-000000000003",
      "name": "Read Voice Inbox",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
      "position": [
        480,
        0
      ],
      "credentials": {
        "clickUpApi": {
          "id": "VQ5XfHCutEhP2Rzr",
          "name": "ClickUp account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const candidate = $('Validate test message').first().json;\nconst exists = $input.all().some(({ json }) => json.description?.trim() === candidate.reference);\nreturn exists ? [] : [{ json: candidate }];"
      },
      "id": "d3e2026a-a17d-4f1c-9e00-000000000004",
      "name": "Skip recorded message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "create",
        "team": "1100310000034143",
        "space": "1100310000147758",
        "folderless": true,
        "list": "1100310000198006",
        "name": "={{ $json.title }}",
        "additionalFields": {
          "content": "={{ $json.reference }}"
        }
      },
      "id": "d3e2026a-a17d-4f1c-9e00-000000000005",
      "name": "Create Voice Inbox task",
      "type": "n8n-nodes-base.clickUp",
      "typeVersion": 1,
