      ],
      "credentials": {
        "clickUpApi": {
          "id": "VQ5XfHCutEhP2Rzr",
          "name": "ClickUp account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://waha:3000/api/sendText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { session: 'default', chatId: $('Validate test message').first().json.chatId, text: 'Created in Voice Inbox: ' + $json.name + '\\nhttps://app.clickup.com/t/' + $json.id, linkPreview: false } }}",
        "options": {
          "timeout": 15000
        }
      },
